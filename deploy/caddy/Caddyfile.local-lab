{
  auto_https disable_redirects
}

# Local-lab only: issue a private certificate from Caddy's local CA. Production
# continues to use Caddyfile and organization-managed TLS.
https://{$AUTH_HOST} {
  tls internal
  reverse_proxy authelia:9091
}

https://{$FTD_SHUN_HOST} {
  tls internal
  # Preserve this order: untrusted client identity is removed before
  # ForwardAuth copies the authenticated Authelia response headers.
  route {
    request_header -Remote-User
    request_header -Remote-Groups
    request_header -Remote-Email
    request_header -Remote-Name
    forward_auth authelia:9091 {
      uri /api/authz/forward-auth?authelia_url=https://{$AUTH_HOST}/
      copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
    }
    reverse_proxy unix//run/ftd-shun-manager/web.sock
  }
}
