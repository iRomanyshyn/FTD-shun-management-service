# Maximum age of the user's Authelia session before a shun removal needs a new login.
# Supported examples: 1h, 24h.
AUTH_SENSITIVE_ACTION_MAX_AGE=24h
AUTH_SESSION_INACTIVITY=1h
AUTH_COOKIE_DOMAIN=internal.example

# Generate long random values with a password manager or openssl. Never commit .env.
AUTHELIA_SESSION_SECRET=replace-with-a-random-secret
AUTHELIA_STORAGE_ENCRYPTION_KEY=replace-with-a-random-secret
# Numeric owner of deploy/authelia/users.yml on the Compose host. Use `id -u`
# and `id -g`; 1000 is the common single-user Linux workstation default.
FTD_SHUN_AUTHELIA_UID=1000
FTD_SHUN_AUTHELIA_GID=1000

# Public names and listener used by Caddy. Use an internal administrative address.
PUBLISH_ADDRESS=10.20.10.50
FTD_SHUN_HOST=ftd-shun.internal.example
AUTH_HOST=auth.internal.example

# Production must use socket. `mock` is only for local development and tests.
FTD_SHUN_AGENT_MODE=socket

# FTD SSH agent. FTD exposes Basic and Config CLI roles, not a per-command
# allowlist. Validate Basic access in the lab first; if REMOVE_SHUN requires
# Config, record the broader-privilege risk and rely on agent/network isolation.
# Restrict every FTD management ACL to this host's approved source address.
# Public inventory path on the host, relative to deploy/ (or absolute). IDs are
# permanent; an address change must not create a new ID or change its pinned key.
FTD_SHUN_DEVICE_INVENTORY_PATH=./devices.json
# Legacy shared mode only. For separate logins/secrets, use the agent-only
# compose.per-device-credentials.yml overlay; never put passwords in this file.
FTD_SHUN_SSH_USERNAME=ftd-shun-service
# Supported range: 5-120 seconds. The default is 45.
FTD_SHUN_AGENT_TIMEOUT_SECONDS=45

# Agent-only connection-worker limit, canonical integer 1-10. Keep 1 (serial)
# until separately validated multi-device scheduling is available. Setting 4
# does not enable API parallelism, ADD, session cycles or bulk policy.
FTD_SHUN_AGENT_MAX_CONCURRENT_DEVICES=1

# Experimental single-session removal cycles. Keep false until live lab validation.
# The API and Rust agent must use the same value; failures never fall back to legacy writes.
FTD_SHUN_AGENT_CYCLES_ENABLED=false

# Experimental bounded multi-frame reads. Upgrade API/agent together before opt-in.
# Does not enable ADD/import; legacy snapshots remain unchanged when false.
FTD_SHUN_LARGE_SNAPSHOTS_ENABLED=false

# Agent-only experimental ADD/cycle v3 gate. Requires both flags above and an
# explicit per-device addition_profile. The separate API execution gate must
# also be true for queued ADD. Do not enable until scoped ADD lab validation.
FTD_SHUN_AGENT_ADDITIONS_ENABLED=false

# Private API import admission; no BFF submit action. Accepted ADD is held unless
# the independent execution gate and explicit device profile permit dispatch.
# This is NOT an execution switch. Keep false in the deployed lab for this step.
FTD_SHUN_IMPORT_ADMISSION_ENABLED=false

# API scheduler ADD dispatch, independently default-off. Requires socket mode,
# cycles, large reads and explicit per-device addition profiles. Does NOT enable
# the agent gate. Keep false until the documented scoped live ADD validation.
FTD_SHUN_IMPORT_EXECUTION_ENABLED=false
# Optional single/fleet cleanup handoff worker; does not enable admission or restoration.
# One shared lease/cooldown, at most eight roots of each kind before cycle cutoff.
# Requires socket mode. Never seed pending handoffs in the lab without approval.
FTD_SHUN_MANAGED_REMOVAL_WORKER_ENABLED=false

# Managed absence discovery + shared system ADD dispatch. Requires API ADD
# execution above, agent ADD/profile gates and explicitly initialized, authorized,
# unsuspended managed policy. Does not create policy, resume it or enable imports.
# Keep off in the current lab; no optional schema is initialized by startup.
FTD_SHUN_MANAGED_RESTORATION_ENABLED=false

# Policy-only standing grant for one exact device/IP. Requires socket mode,
# explicit addition profile and existing optional registry/attempt schemas.
# Does not initialize/resume policy or enable ADD. Keep false in the current lab.
FTD_SHUN_MANAGED_POLICY_ADMISSION_ENABLED=false

# Atomic stop-maintaining + cleanup admission for frozen device/fleet reviews.
# Requires socket mode and cleanup worker above; never initializes optional schemas.
# Separate from ADD/restoration/policy grants. Keep false in the current lab.
FTD_SHUN_MANAGED_REMOVAL_ADMISSION_ENABLED=false

# A complete typed `show shun` snapshot is collected at this interval. Browser
# activity may queue one background refresh, never a synchronous Cisco query.
FTD_SHUN_POLL_INTERVAL=5m
FTD_SHUN_INTERACTIVE_REFRESH_MIN_INTERVAL=60s

# Retain historical audit events and inactive shun state for this many days.
# Valid range: 1-3653. Expired records are purged daily; the default is 366.
FTD_SHUN_HISTORY_RETENTION_DAYS=366

# Protected IPs are managed by authenticated users in the UI and stored in SQLite.
